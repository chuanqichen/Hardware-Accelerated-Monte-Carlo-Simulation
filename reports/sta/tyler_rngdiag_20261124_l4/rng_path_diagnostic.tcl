# Read-only PrimeTime path diagnostic for the four-lane RNG setup endpoint.
# Mirrors scripts/sta/prelayout.tcl routed settings: typical corner, the
# consumed SDC, the routed SPEF and propagated clocks. Reports only; no SDC,
# netlist or library change. Run from the repository root:
#   pt_shell -f reports/sta/tyler_rngdiag_20261124_l4/rng_path_diagnostic.tcl
set root [pwd]
source [file join $root scripts syn config.tcl]
set run reports/pnr/tyler_closure2_20261123_l4
set ptref reports/sta/tyler_closure2_20261123_l4_routed_final
set out reports/sta/tyler_rngdiag_20261124_l4
set lib [mc_library $root db]
set spef $::env(RNGDIAG_SPEF)
set_app_var link_path [list * $lib]
set_app_var link_create_black_boxes false
read_verilog $run/mc_top.routed.v
if {![link_design mc_top]} { error "PrimeTime link failed" }
set_operating_conditions typical
if {[read_sdc $ptref/constraints.pt.sdc] != 1} { error "Failed to read complete SDC" }
read_parasitics $spef
set_propagated_clock [all_clocks]
update_timing
set f [open $out/inputs.txt w]
puts $f "tool=[get_app_var sh_product_version]"
puts $f "netlist=$run/mc_top.routed.v
sdc=$ptref/constraints.pt.sdc
library=$lib
corner=typical"
puts $f "spef=$run/mc_top.routed.spef.gz (decompressed copy)
analysis=routed_parasitics_propagated_clocks_same_as_ptref"
puts $f "timing_remove_clock_reconvergence_pessimism=[get_app_var timing_remove_clock_reconvergence_pessimism]"
puts $f "si_enable_analysis=[get_app_var si_enable_analysis]"
close $f
set opts {-delay_type max -nosplit -significant_digits 6 -path_type full_clock_expanded -transition_time -input_pins -nets -capacitance}

# Same startpoint, traversed pins and transitions as the Innovus innovus si on path report.
redirect $out/pt_innovus_si_on_path.rpt { report_timing {*}$opts -from [get_pins {u_lanes/g_lane_3__u_rng/s0_reg_5_/CLK}] -fall_through [get_pins {u_lanes/g_lane_3__u_rng/s0_reg_5_/Q}] -fall_through [get_pins {u_lanes/g_lane_3__u_rng/U151/A}] -fall_through [get_pins {u_lanes/g_lane_3__u_rng/U151/Y}] -fall_through [get_pins {u_lanes/g_lane_3__u_rng/intadd_131_U20/B}] -fall_through [get_pins {u_lanes/g_lane_3__u_rng/intadd_131_U20/YC}] -fall_through [get_pins {u_lanes/g_lane_3__u_rng/intadd_131_U19/C}] -fall_through [get_pins {u_lanes/g_lane_3__u_rng/intadd_131_U19/YC}] -fall_through [get_pins {u_lanes/g_lane_3__u_rng/intadd_131_U18/C}] -fall_through [get_pins {u_lanes/g_lane_3__u_rng/intadd_131_U18/YC}] -fall_through [get_pins {u_lanes/g_lane_3__u_rng/intadd_131_U17/C}] -fall_through [get_pins {u_lanes/g_lane_3__u_rng/intadd_131_U17/YC}] -fall_through [get_pins {u_lanes/g_lane_3__u_rng/intadd_131_U16/C}] -fall_through [get_pins {u_lanes/g_lane_3__u_rng/intadd_131_U16/YC}] -fall_through [get_pins {u_lanes/g_lane_3__u_rng/intadd_131_U15/C}] -fall_through [get_pins {u_lanes/g_lane_3__u_rng/intadd_131_U15/YC}] -fall_through [get_pins {u_lanes/g_lane_3__u_rng/intadd_131_U14/C}] -fall_through [get_pins {u_lanes/g_lane_3__u_rng/intadd_131_U14/YC}] -fall_through [get_pins {u_lanes/g_lane_3__u_rng/intadd_131_U13/C}] -fall_through [get_pins {u_lanes/g_lane_3__u_rng/intadd_131_U13/YC}] -fall_through [get_pins {u_lanes/g_lane_3__u_rng/intadd_131_U12/C}] -fall_through [get_pins {u_lanes/g_lane_3__u_rng/intadd_131_U12/YC}] -fall_through [get_pins {u_lanes/g_lane_3__u_rng/intadd_131_U11/C}] -fall_through [get_pins {u_lanes/g_lane_3__u_rng/intadd_131_U11/YC}] -fall_through [get_pins {u_lanes/g_lane_3__u_rng/intadd_131_U10/C}] -fall_through [get_pins {u_lanes/g_lane_3__u_rng/intadd_131_U10/YC}] -fall_through [get_pins {u_lanes/g_lane_3__u_rng/intadd_131_U9/C}] -fall_through [get_pins {u_lanes/g_lane_3__u_rng/intadd_131_U9/YC}] -fall_through [get_pins {u_lanes/g_lane_3__u_rng/intadd_1