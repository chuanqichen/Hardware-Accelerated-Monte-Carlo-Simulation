###################################################################
set sdc_version 2.1

set_units -time ns -resistance kOhm -capacitance pF -voltage V -current uA
set_max_transition 0.3 [current_design]
set_max_fanout 16 [current_design]
set_driving_cell -lib_cell INVX1 -pin Y [get_ports rst_n]
set_driving_cell -lib_cell INVX1 -pin Y [get_ports in_valid]
set_driving_cell -lib_cell INVX1 -pin Y [get_ports {u[31]}]
set_driving_cell -lib_cell INVX1 -pin Y [get_ports {u[30]}]
